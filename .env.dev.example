# Modèle de configuration pour `scripts/dev-auth.mjs`.
#
#   cp .env.dev.example .env.dev
#   (remplir les 2 valeurs ci-dessous)
#
# `.env.dev` est GITIGNORÉ : c'est le seul endroit où le secret a le droit
# d'exister. Il ne doit JAMAIS être préfixé `VITE_` — tout ce qui commence par
# `VITE_` finit dans le bundle public.
#
# Où trouver les valeurs :
#   SUPABASE_URL        → dashboard Supabase > Project Settings > API > Project URL
#   INTERNAL_FN_SECRET  → la valeur que tu as posée via
#                         `supabase secrets set INTERNAL_FN_SECRET=...`
#                         (elle n'est pas relisible : si tu l'as perdue,
#                          re-pose-la sur la fonction ET ici)

SUPABASE_URL=
INTERNAL_FN_SECRET=
