{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    /* M-63 (S6, plan v2) : `evidenceFromMirrorValidation` + les re-exports
       de `recompute.ts` résolvent les chemins relatifs `.ts` explicites. */
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist"
  ],
  "references": [
    {
      "path": "../domain"
    }
  ]
}
