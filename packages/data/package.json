{
  "name": "@aurora/data",
  "version": "0.0.0",
  "private": true,
  "description": "PowerSync/SQLite repositories, migrations, PowerSync views/scopes, Model Registry owner (AD-16b), React-Query bridge",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./powersync-engine-capacitor": {
      "types": "./src/powersync-engine-capacitor.ts",
      "default": "./src/powersync-engine-capacitor.ts"
    },
    "./powersync-engine-web": {
      "types": "./src/powersync-engine-web.ts",
      "default": "./src/powersync-engine-web.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings --import ./test/register-data-tests.mjs test/run.ts"
  },
  "dependencies": {
    "@aurora/domain": "workspace:*",
    "@powersync/capacitor": "^0.9.2",
    "@powersync/common": "2.3.0",
    "@powersync/web": "2.4.1",
    "@supabase/supabase-js": "^2.117.1"
  }
}
