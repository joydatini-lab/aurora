{
  "extends": ["../../tsconfig.base.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
