{
  "name": "@aurora/web-app",
  "version": "0.0.0",
  "private": true,
  "description": "Aurora web shell — React pur (React Router + shadcn/ReUI, AUCUN ion-*) : la surface complète web-first (ADR-018 / D-018.1, OQ-10). Electron l'enveloppe (apps/desktop), ce n'est pas un 3e front.",
  "type": "module",
  "scripts": {
