# En-têtes de la coquille web.
#
# Le design space ne stocke aucune donnée sensible, mais la CSP est posée dès
# le premier jour : la rajouter après coup oblige à auditer chaque écran.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Les assets sont immuables (nom haché par Vite).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# L'index doit toujours être revalidé : sinon un déploiement reste invisible
# pendant des heures chez les visiteurs ayant l'ancienne version en cache.
/index.html
  Cache-Control: no-cache
