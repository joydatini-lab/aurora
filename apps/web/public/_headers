# Aurora WEB — en-têtes d'hébergement (Netlify / Cloudflare Pages : `_headers`).
#
# 1) CROSS-ORIGIN ISOLATION (obligatoire, B4) — `@powersync/web` tourne sur
#    WASQLite, qui a besoin de `SharedArrayBuffer`. Le navigateur ne l'expose
#    QUE sur une page cross-origin isolated. SANS ces deux en-têtes :
#    pas de SQLite local, donc PAS d'offline-first (AD-7) — l'app retombe en
#    mode mémoire et perd son état au reload.
#
# 2) SPA FALLBACK — `createBrowserRouter` sert des routes profondes
#    (/goals/:id). L'hôte doit renvoyer index.html pour tout chemin inconnu :
#    voir `_redirects` (Netlify/CF Pages) ou `vercel.json` (Vercel).

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Les assets sont fingerprintés → cache immuable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# La coquille ne doit JAMAIS être mise en cache longue : sinon un déploiement
# ne se propage pas (l'utilisateur reste sur l'ancien index.html).
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
