{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "../mobile/src/*"
      ],
      "@aurora/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "src/*": [
        "../../packages/ui/src/*"
      ]
    },
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e"
  ],
  "exclude": [
    "dist",
    "playwright-report",
    "test-results"
  ]
}
