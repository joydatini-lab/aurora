{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    /**
     * Sibling packages (focus / goal-engine / platform) typecheck with
     * `allowImportingTsExtensions` — their cross-file `.ts` imports surface
     * as TS5097 through project references when mobile's noEmit config is
     * the active one. Mirror the flag so `pnpm typecheck` (noEmit, CI gate)
     * passes. The `build` script emits with noEmit=false (no conflict).
     */
    "allowImportingTsExtensions": true,
    /* M-62 (S6, plan v2) : le composant React `mirror-findings-card.tsx`
       est importé avec son extension `.tsx` explicite — le fichier .ts
       voisin a le même stem (les pures fonctions), le TS résout `.ts`
       d'abord → l'import sans extension ne voit PAS le composant.
       `allowArbitraryExtensions` autorise l'import explicite `.tsx`
       (le bundler/vite résout de même). */
    "allowArbitraryExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    /* @aurora/ui's package.json points `types` at `src/index.ts` (the live
       SSoT, AD-15) — but a stale pre-built `packages/ui/dist/` (2026-10-06)
       still sits on disk, and the `bundler` resolver can surface its
       `dist/index.d.ts` through the node_modules symlink. The `paths`
       override below forces resolution to the SOURCE `src/index.ts`
       directly, so typecheck + build see the live catalog (the new
       gradient/accentInk/resolveImageThemeFile exports, 05 §5.4 rework)
       and never the lagging build artifact. */
    "baseUrl": ".",
    "paths": {
      "@aurora/ui": ["../../packages/ui/src/index.ts"],
      /* Le `paths` d'un enfant REMPLACE celui du base : re-declarer l'alias
         `src/*` de packages/ui, sinon les 334 imports `src/...` du depot
         echouent en TS2307 des que mobile lit les sources de @aurora/ui. */
      "src/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src"
  ],
  "files": [
    /* M-62 (S6) : le .tsx du bloc miroir est importé avec son extension
       explicite (`allowArbitraryExtensions`) — un import arbitraire doit
       lister le fichier dans le projet (TS6307 sinon ; le glob `src` ne
       suffit pas en mode composite/incremental hérité du base). */
    "src/components/agent/mirror-findings-card.tsx"
  ],
  "exclude": [
    "dist"
  ]}
