{
  // Solution FILE — plus de `references` : depuis le 2026-10-28 tous les
  // packages sont consommés en SOURCE (`exports` -> `src/index.ts`, alias
  // Vite), donc les project-references n'apportaient rien et cassaient le
  // typecheck (`tsc --noEmit` par package + `composite` = TS6305 x184).
  //
  // Le gate réel = `pnpm typecheck` (récursif, un programme par package).
  // `npx tsc -b` n'est plus le chemin supporté.
  "files": [],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
