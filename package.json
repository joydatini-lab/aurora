{
  "name": "@aurora/root",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Aurora — monorepo web (socle technique : apps/web + domain + data)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -F @aurora/web dev",
    "design-api": "node tools/design-api/server.mjs",
    "dev:full": "node tools/design-api/server.mjs & pnpm -F @aurora/web dev",
    "build": "pnpm -F @aurora/web build",
    "preview": "pnpm -F @aurora/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:auth": "node scripts/dev-auth.mjs",
    "check:boundaries": "sh scripts/check-boundaries.sh",
    "check:bundle": "node scripts/check-web-bundle-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
