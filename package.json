{
  "name": "@aurora/root",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Aurora monorepo — pnpm workspace (wave 0 foundation)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -F @aurora/mobile dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build-storybook": "pnpm --filter @aurora/ui build-storybook",
    "build-storybook-ui": "pnpm --filter @aurora/ui build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@antv/f-react": "^1.10.0",
    "@antv/f2": "^5.14.0",
    "@assistant-ui/react": "^0.15.28"
  }
}
